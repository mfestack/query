{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@mfestack/core": ["./packages/core/src"],
      "@mfestack/core/*": ["./packages/core/src/*"],
      "@mfestack/react": ["./packages/react/src"],
      "@mfestack/react/*": ["./packages/react/src/*"],
      "@mfestack/vue": ["./packages/vue/src"],
      "@mfestack/vue/*": ["./packages/vue/src/*"],
      "@mfestack/angular": ["./packages/angular/src"],
      "@mfestack/angular/*": ["./packages/angular/src/*"],
      "@mfestack/svelte": ["./packages/svelte/src"],
      "@mfestack/svelte/*": ["./packages/svelte/src/*"],
      "@mfestack/solid": ["./packages/solid/src"],
      "@mfestack/solid/*": ["./packages/solid/src/*"],
      "@mfestack/devtools": ["./packages/devtools/src"],
      "@mfestack/devtools/*": ["./packages/devtools/src/*"],
      "@mfestack/persist-client": ["./packages/persist-client/src"],
      "@mfestack/persist-client/*": ["./packages/persist-client/src/*"],
      "@mfestack/broadcast-client": ["./packages/broadcast-client/src"],
      "@mfestack/broadcast-client/*": ["./packages/broadcast-client/src/*"],
      "@mfestack/test-utils": ["./packages/test-utils/src"],
      "@mfestack/test-utils/*": ["./packages/test-utils/src/*"]
    }
  },
  "include": ["packages/**/*", "integrations/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
