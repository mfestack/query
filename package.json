{
  "name": "mfestack-query",
  "version": "0.1.0",
  "private": true,
  "description": "A next-generation data-fetching and caching library inspired by TanStack Query",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/mfestack-query.git"
  },
  "packageManager": "pnpm@10.17.0",
  "type": "module",
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "preinstall": "node -e \"if(process.env.CI == 'true') {console.log('Skipping preinstall...')} else {process.exit(1)}\" || npx -y only-allow pnpm",
    "test": "pnpm run test:ci",
    "test:ci": "nx run-many --targets=test:eslint,test:lib,test:types,test:build,build",
    "test:eslint": "nx affected --target=test:eslint",
    "test:format": "pnpm run prettier --check",
    "test:lib": "nx affected --target=test:lib --exclude=examples/**",
    "test:lib:dev": "pnpm run test:lib && nx watch --all -- pnpm run test:lib",
    "test:build": "nx affected --target=test:build --exclude=examples/**",
    "test:types": "nx affected --target=test:types --exclude=examples/**",
    "build": "nx affected --target=build --exclude=examples/** --exclude=integrations/**",
    "build:all": "nx run-many --target=build --exclude=examples/** --exclude=integrations/** --exclude=@mfestack/test-utils --nx-bail=false",
    "watch": "pnpm run build:all && nx watch --all -- pnpm run build:all",
    "dev": "pnpm run watch",
    "prettier": "prettier --experimental-cli --ignore-unknown '**/*'",
    "prettier:write": "pnpm run prettier --write",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm prettier:write",
    "changeset:publish": "changeset publish",
    "benchmark": "pnpm exec size-limit && pnpm --filter @mfestack/benchmarks benchmark:perf",
    "benchmark:size": "pnpm exec size-limit",
    "benchmark:perf": "pnpm --filter @mfestack/benchmarks benchmark:perf",
    "benchmark:treeshake": "pnpm --filter @mfestack/benchmarks benchmark:treeshake",
    "docs:dev": "pnpm --filter @mfestack/docs-site dev",
    "docs:build": "pnpm --filter @mfestack/docs-site build",
    "docs:preview": "pnpm --filter @mfestack/docs-site preview"
  },
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@tanstack/config": "^0.20.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-istanbul": "3.2.4",
    "esbuild": "^0.25.11",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "eslint": "^9.36.0",
    "jsdom": "^27.0.0",
    "nx": "21.5.3",
    "premove": "^4.0.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.4.0",
    "typescript": "5.8.3",
    "vite": "^6.3.6",
    "vitepress": "^1.6.4",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@mfestack/core": "workspace:*",
      "@mfestack/react": "workspace:*",
      "@mfestack/vue": "workspace:*",
      "@mfestack/angular": "workspace:*",
      "@mfestack/svelte": "workspace:*",
      "@mfestack/solid": "workspace:*",
      "@mfestack/devtools": "workspace:*",
      "@mfestack/react-devtools": "workspace:*",
      "@mfestack/devtools-core": "workspace:*",
      "@mfestack/persist-client": "workspace:*",
      "@mfestack/broadcast-client": "workspace:*",
      "@mfestack/test-utils": "workspace:*"
    }
  }
}